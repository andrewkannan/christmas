# Team Dashboard PIN (change this before going out on the street!)
TEAM_PIN=1225

# Secret used to sign HttpOnly team session cookies (use a long random string in production)
SESSION_SECRET=replace-with-a-random-32-char-secret-in-production

# Server port & database persistence
# On Railway: add a Variable Reference DATABASE_URL=${{Postgres.DATABASE_URL}} on your Web service
# When DATABASE_URL is set, contacts, remarks, leaderboards & settings persist in PostgreSQL across every git push.
PORT=3001
# DATABASE_URL=postgresql://postgres:password@localhost:5432/railway
DB_PATH=./data/christmas.db
